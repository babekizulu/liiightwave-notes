# Never put real credentials in this example file or commit .env files.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173
ADDITIONAL_ORIGINS=
GENERATION_MODE=demo
DATABASE_URL=
DATA_DIR=.data
SEED_DEMO=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
RESEND_API_KEY=
MAIL_FROM=
DAILY_GENERATIONS=20
GLOBAL_DAILY_GENERATIONS=200
# Railway: NODE_ENV=production, HOST=0.0.0.0, a private DATABASE_URL,
# CLIENT_ORIGIN=https://notes.liiightwave.com, verified email delivery,
# and server-only OpenAI credentials are required for the AI release.
